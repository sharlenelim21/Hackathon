# Copy to .streamlit/secrets.toml (gitignored) and fill in. Ask Jy for the key privately; never commit it.
LLM_PROVIDER = "openai_compatible"
LLM_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_API_KEY = "paste-key-here"
LLM_MODEL = "gemini-3.5-flash-lite"
LLM_FALLBACK_MODELS = "gemini-3.1-flash-lite,gemini-3.5-flash"
LLM_MAX_TOKENS = "3000"
# Offline / tests: LLM_PROVIDER = "fake"
